# Copy to .env (optional; every value has a safe local default).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Human-readable logs in the terminal (JSON is the default and what production should use).
LOG_PRETTY=true
# SQLite database file, relative to apps/api.
DATABASE_PATH=./data/media-library.db
# Lifetime of issued bearer tokens, in hours (default: 7 days).
AUTH_TOKEN_TTL_HOURS=168
# Password for the seeded demo users (free-user, premium-user). Local demo value only — if unset,
# `npm run db:reset` generates a random one and prints it.
DEMO_USER_PASSWORD=demo-password
